{
  "format": "mousse-net-security-oracle-v1",
  "kind": "abstract-invite-authorization",
  "securityTests": [
    "SEC-007",
    "SEC-008",
    "SEC-009"
  ],
  "limitations": "Checks use stipulated validated credentials and current issuer roster. No bearer token or secret is present. A malicious host may fabricate redemption of unused authorized bearer slots; these cases do not assert joiner intent.",
  "cases": [
    {
      "id": "admin-member-invite",
      "input": {
        "issuerRoleAtIssue": "admin",
        "issuerRoleNow": "admin",
        "issuerCurrentRosterAvailable": true,
        "issuerDelegationCurrent": true,
        "inviteSignatureValid": true,
        "descriptorEpoch": 1,
        "inviteEpoch": 1,
        "role": "member",
        "uses": 1,
        "inviteUse": 1,
        "usedSlots": [],
        "memberRootMatches": true,
        "receiptSignedByCurrentHost": true,
        "issuedAt": 1000,
        "expiresAt": 86401000,
        "receiptAt": 2000,
        "optionalJoinerMatches": true
      },
      "expected": {
        "decision": "allow",
        "code": null,
        "memberAdded": true
      }
    },
    {
      "id": "owner-admin-invite",
