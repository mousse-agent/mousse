#!/usr/bin/env bash
# Packaged mousse-cli entry: run the Electron app in headless CLI mode.
# Keep this file next to the Mousse binary (or inside the .app Contents/MacOS on macOS).
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# An editor's ssh runs "net ssh-proxy" on every reconnect. Starting the whole app for it is slow; the proxy is a
# script of its own that runs on the app's runtime as plain Node. When the script is not found, the app runs it.
if [[ "${1:-}" == "net" && "${2:-}" == "ssh-proxy" ]]; then
  for app in "$DIR/Mousse" "$DIR/mousse" "$DIR/../MacOS/Mousse"; do
    for asar in "$DIR/resources/app.asar" "$DIR/../Resources/app.asar" "$DIR/app.asar"; do
      if [[ -x "$app" && -f "$asar" ]]; then
        ELECTRON_RUN_AS_NODE=1 exec "$app" "$asar/out/cli/ssh-proxy.js" "$@"
      fi
    done
  done
fi

export MOUSSE_CLI=1

if [[ -x "$DIR/Mousse" ]]; then
  exec "$DIR/Mousse" --cli "$@"
elif [[ -x "$DIR/mousse" ]]; then
  exec "$DIR/mousse" --cli "$@"
elif [[ -x "$DIR/../MacOS/Mousse" ]]; then
  exec "$DIR/../MacOS/Mousse" --cli "$@"
else
  echo "mousse-cli: could not find Mousse app binary next to $DIR" >&2
  exit 127
fi
